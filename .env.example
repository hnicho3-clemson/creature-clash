# Copy these into Vercel > Project > Settings > Environment Variables. Never commit real values.

# Added automatically when you connect a Neon database from Vercel's Storage tab.
DATABASE_URL=

# 32+ random characters. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# From resend.com (or Vercel's Resend integration). Needed to send codes and parent emails.
RESEND_API_KEY=
# A sender on a domain you verified in Resend, e.g. "Creature Clash <noreply@yourdomain.com>"
MAIL_FROM=

# Your site's public address, used in parent approval links, e.g. https://creature-clash.vercel.app
SITE_URL=

# Usernames allowed to open the Admin Analytics page at /admin, separated by commas. e.g. haley
ADMIN_USERNAMES=

# Local development only (npm run dev). Leave DATABASE_URL empty to use the built-in database in .data/.
# Put these in a .env.local file, which git ignores.
# LOCAL_PG=-h localhost -p 5432 -U postgres
# PORT=3000
