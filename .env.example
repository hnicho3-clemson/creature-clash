# Optional settings. Copy this file to .env.local (next to package.json) and fill in what you need.
# The game works without any of them.

# Usernames that can open Admin Analytics at http://localhost:3000/admin, separated by commas. e.g. haley
ADMIN_USERNAMES=

# Port for the game (default 3000).
# PORT=3000

# Who can reach the game. 127.0.0.1 (default) = only this computer.
# 0.0.0.0 = also tablets and computers on the same Wi-Fi (they open http://<this computer's IP>:3000).
# HOST=127.0.0.1

# Where the database and backups are kept (default: the data folder in the game folder).
# CC_DATA_DIR=

# Optional: send account emails for real through Resend (resend.com) instead of printing them in the server window.
# RESEND_API_KEY=
# MAIL_FROM=Creature Clash <noreply@yourdomain.com>
